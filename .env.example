# 이 파일을 복사해서 .env 로 이름을 바꾸고 키를 채우세요. (.env 는 깃허브에 안 올라감)

# 필수: https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=
# 선택: 기본값 gemini-3.8-flash
GEMINI_MODEL=
# 선택: 키에 구글 검색 할당량이 없으면 off (실패하는 검색 시도를 건너뜀)
GEMINI_SEARCH=

# 선택(해커톤 기록용): Get your project key at neatlogs.com
# In Claude Code cloud sessions the agent proxy injects the real keys for
# ingest.neatlogs.com and generativelanguage.googleapis.com; any non-empty
# placeholder satisfies the local checks. Node only routes fetch through that
# proxy with NODE_USE_ENV_PROXY=1 (set in .claude/settings.json).
NEATLOGS_API_KEY=
